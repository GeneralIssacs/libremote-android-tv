    <!-- Remote guide: one name and description per button, from RemoteGuide.sections -->
    <string name="guide_title">Remote guide</string>
    <string name="guide_intro">What each button does, from the top of the screen down. TVs differ, so some keys work only on some TVs, as noted.</string>
    <string name="guide_top">Top of the screen</string>
    <string name="guide_tv_name">TV name</string>
    <string name="guide_tv_name_does">Opens the TV menu: switch to another TV or add one, and this TV\'s Find my remote, Channel buttons and About this TV.</string>
    <string name="guide_send_files_does">Sends photos, videos and other files to the TV.</string>
    <string name="guide_send_files_caveat">Needs Libremote Receiver on the TV. Libremote opens it there by itself.</string>
    <string name="guide_power_does">Turns the TV\'s screen on or off. The button turns solid while the screen is off.</string>
    <string name="guide_power_caveat">Turning the TV on works only if it stays on the network while off. Many TVs have a setting for this.</string>
    <string name="guide_app_settings_does">Libremote\'s settings: controls, shortcuts, this guide and your TVs.</string>
    <string name="guide_tv_menu">TV menu (under the TV\'s name)</string>
    <string name="guide_add_tv_does">Pairs another TV. Also in Settings.</string>
    <string name="guide_find_remote_does">Makes the TV\'s own remote beep, so you can find it.</string>
    <string name="guide_find_remote_caveat">Only on TVs whose remote can beep. The menu offers it only then.</string>
    <string name="guide_tv_buttons_does">On, for a TV: Channel +, Menu and Channel − on the right. Off, for a streaming box: Search, Menu and Apps.</string>
    <string name="guide_tv_buttons_caveat">Libremote sets it from the model the TV reports. Change it here if it guessed wrong.</string>
    <string name="guide_about_tv_does">What this TV reports about itself: model, Android version, remote service and the features it offers.</string>
    <string name="guide_pad">Full, D-pad and Touchpad</string>
    <string name="guide_full_does">Everything at once: a smaller D-pad, a swipe strip, and a row of extra keys.</string>
    <string name="guide_dpad_does">The arrows move around the TV\'s screen and the centre selects. Hold the centre for an item\'s options, or an arrow to scroll fast.</string>
    <string name="guide_touchpad_does">Swipe to move, tap to select, hold for options. Choose Full, D-pad or Touchpad above the pad.</string>
    <string name="guide_strip_does">In Full, under the D-pad: swipe to move a step at a time, or quickly to go further. Tap for OK, hold for options.</string>
    <string name="guide_volume">Left: volume</string>
    <string name="guide_volume_up_does">Turns the volume up. Hold to keep going.</string>
    <string name="guide_mute_does">Mutes or unmutes the sound.</string>
    <string name="guide_volume_down_does">Turns the volume down. Hold to keep going.</string>
    <string name="guide_volume_caveat">Also reaches a sound system connected over HDMI-CEC. Your phone\'s volume buttons do the same while the remote is open.</string>
    <string name="guide_right">Right: channels, or Search and Apps</string>
    <string name="guide_right_note">TVs get Channel +, Menu and Channel −. Streaming boxes, such as the NVIDIA Shield, a Chromecast or the Google TV Streamer, get Search, Menu and Apps. Libremote tells them apart by the model the TV reports; Channel buttons in the TV menu changes it.</string>
    <string name="guide_channel_up_does">Next channel. Hold to keep going.</string>
    <string name="guide_channel_down_does">Previous channel. Hold to keep going.</string>
    <string name="guide_channel_caveat">In live-TV apps.</string>
    <string name="guide_menu_key_does">Opens the current app\'s menu.</string>
    <string name="guide_menu_key_caveat">What it does depends on the TV and the app. On the NVIDIA Shield it opens the settings.</string>
    <string name="guide_search_does">Opens the TV\'s search.</string>
    <string name="guide_apps_does">Opens the list of apps, as holding Home does.</string>
    <string name="guide_apps_caveat">Some TVs show their dashboard instead.</string>
    <string name="guide_extra_keys">Full: extra keys</string>
    <string name="guide_extra_keys_note">In Full, the row above the D-pad. On a TV it also has Search and Apps, as above.</string>
    <string name="guide_captions_does">Turns subtitles on or off.</string>
    <string name="guide_in_apps_caveat">In apps that support it.</string>
    <string name="guide_info_does">Shows information about what\'s on screen.</string>
    <string name="guide_info_caveat">Only on some TVs, such as the NVIDIA Shield. Stock Android TV ignores it.</string>
    <string name="guide_guide_does">Opens the live-TV programme guide.</string>
    <string name="guide_guide_caveat">Only on TVs with live channels whose maker supports this key.</string>
    <string name="guide_settings_does">Opens the TV\'s settings.</string>
    <string name="guide_settings_caveat">Only on TVs whose maker supports this key. Stock Android TV ignores it.</string>
    <string name="guide_input_does">Switches the TV\'s input, such as HDMI 1 or the antenna.</string>
    <string name="guide_input_caveat">Only on some TVs. Stock Android TV ignores this key.</string>
    <string name="guide_media">Playback</string>
    <string name="guide_previous_does">Previous track or episode.</string>
    <string name="guide_rewind_does">Rewinds what\'s playing.</string>
    <string name="guide_play_pause_does">Plays or pauses.</string>
    <string name="guide_fast_forward_does">Fast-forwards what\'s playing.</string>
    <string name="guide_next_does">Next track or episode.</string>
    <string name="guide_media_caveat">In apps that support it, which most video apps do.</string>
    <string name="guide_buttons">Back, Home and Keyboard</string>
    <string name="guide_back_does">Goes back one step.</string>
    <string name="guide_home_does">Goes to the home screen.</string>
    <string name="guide_home_caveat">Hold it for the list of apps or the dashboard, depending on the TV.</string>
    <string name="guide_keyboard_does">Opens your phone\'s keyboard to type into the TV\'s text field. Enter runs the field\'s action, such as Search.</string>
    <string name="guide_keyboard_caveat">It also opens by itself when the TV asks for text. You can turn that off in Settings.</string>
    <string name="guide_shortcuts">App shortcuts</string>
    <string name="guide_shortcut">An app</string>
    <string name="guide_shortcut_does">Opens the app on the TV. Hold it to pin, rename or hide it. Settings › Shortcuts sets their order and look.</string>
    <string name="guide_shortcut_caveat">On a TV without the Play Store, most apps open only through Libremote Receiver on the TV. The row is hidden on TVs that can\'t open apps.</string>
    <string name="guide_shortcut_add_does">Adds an app: one you hid, one from the TV\'s list, a popular one, or any app by its package name.</string>

