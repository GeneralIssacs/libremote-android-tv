    <string name="settings_version">Version %1$s</string>
    <string name="settings_privacy">Libremote has no accounts, ads, analytics or crash reporting. It connects only to TVs on your local network, using the same encrypted, paired connection as Google\'s own remote. It also keeps your phone\'s model and Android version from the TV, which can include them in its own usage reports to Google.</string>
