    <string name="send_cant_open_title">Couldn\'t open Libremote Receiver on %1$s</string>
    <string name="send_cant_open_text">Libremote opens it through its remote connection to the TV, which isn\'t available right now. Check that the TV is on, or open Libremote Receiver on the TV yourself, then try again.</string>
    <string name="send_not_listening_title">Libremote Receiver on %1$s didn\'t answer</string>
    <string name="send_not_listening_text">It opened on the TV but didn\'t take the files. If it is an older version, update it on the TV, then try again.</string>
    <string name="send_unverified_title">Couldn\'t verify Libremote Receiver on %1$s</string>
    <string name="send_unverified_text">Libremote couldn\'t confirm that it was talking to the receiver on your TV, so nothing was sent. Try again. If this keeps happening, another device on your network may be answering in its place.</string>
